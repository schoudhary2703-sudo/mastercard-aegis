# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Environment
.env
.env.local

# Data - never commit datasets or generated corpora
data/raw/*
data/interim/*
data/processed/*
data/synthetic/*
data/external/*
data/hardening/*
data/reports/*
data/genai/*
!data/**/.gitkeep
!data/**/README.md

# Model + run artifacts
artifacts/
models/
mlruns/
runs/
*.pkl
*.joblib
*.parquet
*.csv
!tests/**/*.csv

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Curated, tracked demo/judge artifact bundle (see docs/DEPLOYMENT.md) --
# re-included despite the `artifacts/`/`models/` ignores above. Minimal JSON
# evidence only; never `model.json` or `features/` (still excluded here).
!submission/artifacts/
!submission/artifacts/**
