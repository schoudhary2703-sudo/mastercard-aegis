# ---------------------------------------------------------------------------
# AEGIS environment template. Copy to `.env` and edit. `.env` is git-ignored.
# Nothing in the foundation reads these yet; they are the agreed names so that
# Red Team and Blue Team do not invent conflicting ones later.
# ---------------------------------------------------------------------------

# Reproducibility. Every generator / trainer must seed from this unless a run
# explicitly overrides it.
AEGIS_GLOBAL_SEED=20260101

# Filesystem roots (relative to repo root unless absolute).
AEGIS_DATA_DIR=data
AEGIS_RAW_DIR=data/raw
AEGIS_SYNTHETIC_DIR=data/synthetic
AEGIS_PROCESSED_DIR=data/processed
AEGIS_ARTIFACT_DIR=artifacts

# Canonical payment world. PaySim is locked as primary; see docs/DATA_STRATEGY.md
AEGIS_PRIMARY_DATASET=paysim
AEGIS_PAYSIM_PATH=data/raw/paysim/PS_20174392719_1491204439457_log.csv

# Logging
AEGIS_LOG_LEVEL=INFO

# Optional API layer (not implemented in the foundation).
AEGIS_API_HOST=127.0.0.1
AEGIS_API_PORT=8000
